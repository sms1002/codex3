{
  "name": "ai-stat-desktop",
  "version": "1.1.0",
  "description": "Chromium 기반 AI 통계 분석 데스크톱 앱",
  "main": "main.js",
  "author": "AI Stat Project",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/analysis.test.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.aistat.desktop",
    "productName": "AI 통계 분석 도우미",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
